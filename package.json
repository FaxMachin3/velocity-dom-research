{
  "name": "velocity-poc",
  "version": "0.1.0",
  "description": "Experimental compiled DOM runtime and reproducible multi-framework browser benchmarks",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "serve": "node scripts/server.mjs",
    "check": "node bench/check.mjs",
    "bench": "node bench/run.mjs",
    "report": "node bench/report.mjs",
    "verify": "npm test && npm run build && npm run check",
    "check:explorer": "node bench/explorer-check.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@babel/core": "7.29.7",
    "@babel/generator": "8.0.6",
    "@babel/parser": "8.0.7",
    "@babel/traverse": "8.0.7",
    "@babel/types": "8.0.6",
    "@sparticuz/chromium": "153.0.0",
    "babel-preset-solid": "1.9.16",
    "esbuild": "0.28.2",
    "lit": "3.3.3",
    "playwright": "1.58.2",
    "preact": "11.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "solid-js": "1.9.17",
    "svelte": "5.57.2",
    "vue": "3.5.44"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
