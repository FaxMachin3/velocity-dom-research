{
  "name": "velocity-poc",
  "version": "0.4.0",
  "description": "Experimental compiled DOM runtime and reproducible multi-framework browser benchmarks",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "serve": "node scripts/server.mjs",
    "check": "node bench/check.mjs",
    "bench": "node bench/run.mjs",
    "report": "node scripts/v04-report.mjs",
    "verify": "npm run build && npm run test:rust && npm test && npm run check && npm run check:runtime && npm run check:stress && npm run check:explorer",
    "check:explorer": "node bench/explorer-check.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "test:rust": "cargo test --manifest-path rust/planner/Cargo.toml --locked",
    "bench:planner": "node bench/planner.mjs",
    "findings": "node scripts/v04-report.mjs",
    "check:stress": "node bench/stress.mjs",
    "bench:deep": "node bench/deep.mjs",
    "report:release": "node scripts/v04-report.mjs",
    "check:runtime": "node bench/runtime-check.mjs",
    "bench:v04": "node scripts/v04-experiment.mjs",
    "check:release": "node bench/release-check.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@babel/core": "7.29.7",
    "@babel/generator": "8.0.6",
    "@babel/parser": "8.0.7",
    "@babel/traverse": "8.0.7",
    "@babel/types": "8.0.6",
    "@sparticuz/chromium": "153.0.0",
    "babel-preset-solid": "1.9.16",
    "esbuild": "0.28.2",
    "lit": "3.3.3",
    "playwright": "1.58.2",
    "preact": "11.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "solid-js": "1.9.17",
    "svelte": "5.57.2",
    "vue": "3.5.44"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
